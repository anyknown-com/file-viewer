{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "remoteCache": {
    "apiUrl": "https://turbo.anyknown.com",
    "teamSlug": "anyknown"
  },
  "tasks": {
    "build": {
      "inputs": ["src/**", "!src/**/*.test.*", "tsconfig.json", "tsdown.config.ts"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "inputs": [
        "src/**",
        "tsconfig.json",
        "tsconfig.comp.json",
        "vitest.config.ts",
        "tsdown.config.ts"
      ]
    },
    "typecheck:site": {
      "inputs": ["site/**", "!site/dist/**", "src/**", "tsconfig.json"]
    },
    "lint": {
      "inputs": ["src/**", "scripts/**", "site/**", "!site/dist/**", ".oxlintrc.json"]
    },
    "fmt:check": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "check:entry": {
      "inputs": ["src/**", "tsdown.config.ts", "scripts/check-entry-deps.mjs"]
    },
    "test": {
      "inputs": ["src/**", "scripts/**", "vitest.config.ts"]
    },
    "test:browser": {
      "inputs": ["src/**", "vitest.config.ts"]
    },
    "verify:pack": {
      "cache": false
    },
    "check:licenses": {
      "inputs": [
        "package.json",
        "pnpm-lock.yaml",
        "THIRD_PARTY_NOTICES.md",
        "scripts/check-licenses.mjs"
      ]
    }
  }
}
