{
  "name": "@anyknown/file-viewer",
  "version": "0.0.1",
  "description": "View and edit files in the browser: bytes in, Blob out, no server.",
  "homepage": "https://github.com/anyknown-com/file-viewer",
  "bugs": {
    "url": "https://github.com/anyknown-com/file-viewer/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anyknown-com/file-viewer.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./comp": {
      "types": "./dist/comp/index.d.ts",
      "default": "./dist/comp/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.comp.json",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check:entry": "tsdown && node scripts/check-entry-deps.mjs",
    "check": "turbo run typecheck lint fmt:check check:entry",
    "test": "vitest run --project jsdom",
    "test:browser": "vitest run --project browser",
    "verify:pack": "pnpm build && node scripts/verify-pack.mjs",
    "prepublishOnly": "pnpm check && pnpm test && pnpm test:browser && pnpm verify:pack && pnpm check:licenses",
    "check:licenses": "node scripts/check-licenses.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "fflate": "^0.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.3",
    "es-module-lexer": "^3.0.3",
    "jsdom": "^30.1.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "playwright": "^1.64.0",
    "pngjs": "7.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@anyknown/ui": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.30.3"
}
