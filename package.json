{
  "name": "@anyknown/file-viewer",
  "version": "0.0.1",
  "description": "View and edit files in the browser: bytes in, Blob out, no server.",
  "homepage": "https://github.com/anyknown-com/file-viewer",
  "bugs": {
    "url": "https://github.com/anyknown-com/file-viewer/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anyknown-com/file-viewer.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.comp.json",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check:entry": "tsdown",
    "check": "turbo run typecheck lint fmt:check check:entry"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tsdown": "^0.23.0",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@anyknown/ui": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.30.3"
}
