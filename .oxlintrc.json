{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import", "react", "jsx-a11y", "promise", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-console": "warn",
    "eqeqeq": "error",
    "no-unused-vars": "error",
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase"
      }
    ],
    "import/no-cycle": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "max-lines": [
      "error",
      {
        "max": 300,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-depth": ["error", 4],
    "complexity": ["warn", 15],
    "react/react-in-jsx-scope": "off"
  },
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "**/*.d.ts"],
  "overrides": [
    {
      "files": ["scripts/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      "files": ["src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": ["useEffect", "useLayoutEffect"],
                "message": "no effects: use a ref callback with cleanup or an event handler"
              }
            ],
            "patterns": [
              {
                "group": ["@anyknown/*"],
                "message": "file-viewer imports no @anyknown package; hosts import tokens.css (00-overview §2)"
              }
            ]
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "React",
            "property": "useEffect",
            "message": "no effects: use a ref callback with cleanup or an event handler"
          },
          {
            "object": "React",
            "property": "useLayoutEffect",
            "message": "no effects: use a ref callback with cleanup or an event handler"
          }
        ]
      }
    },
    {
      "files": ["src/comp/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "react", "message": "./comp is DOM-free and React-free" },
              { "name": "react-dom", "message": "./comp is DOM-free and React-free" }
            ],
            "patterns": [
              {
                "group": ["react/*", "react-dom/*"],
                "message": "./comp is DOM-free and React-free"
              },
              {
                "group": ["node:*"],
                "message": "./comp runs in Node and browsers: no node:* imports"
              },
              {
                "group": ["../*"],
                "message": "./comp imports only fflate, zod and files in src/comp"
              },
              {
                "group": ["@anyknown/*"],
                "message": "file-viewer imports no @anyknown package; hosts import tokens.css (00-overview §2)"
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          "window",
          "document",
          "self",
          "Buffer",
          "process",
          "createImageBitmap",
          "OffscreenCanvas",
          "Image",
          "ImageData"
        ]
      }
    },
    {
      "files": ["src/comp/**/*.test.ts"],
      "rules": {
        "no-restricted-imports": "off",
        "no-restricted-globals": "off"
      }
    }
  ],
  "settings": {
    "react": {
      "version": "19"
    }
  }
}
